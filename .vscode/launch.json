    "version": "0.2.0",
    "configurations": [
        {
            "name": "Expo: iOS Simulator",
            "type": "node-terminal",
            "request": "launch",
            "command": "zsh -i -c 'nvm use 20 && bunx expo start --ios'"
        },
        {
            "name": "2. Attach to Debugger",
            "type": "expo",
            "request": "attach",
            "projectRoot": "${workspaceFolder}"
        }
    ]
}